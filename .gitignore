# 1. Pliki bazy danych (KRYTYCZNE)
# Bezwzględnie ignorujemy pliki z zaszyfrowanymi hasłami
vault.db
vault_*.db
*.db
*.sqlite3

# 2. Środowisko wirtualne
# Zależności instalujemy zawsze z requirements.txt na docelowej maszynie
venv/
env/
.venv/

# 3. Pamięć podręczna Pythona (Cache)
# Pliki bajtkodu generowane automatycznie przez interpreter
__pycache__/
*.pyc
*.pyo
*.pyd

# 4. Pliki środowisk programistycznych (IDE)
# Ustawienia lokalne edytorów kodu
.vscode/
.idea/
*.swp

# 5. Pliki systemowe
# Śmieci generowane przez systemy operacyjne
.DS_Store
Thumbs.db

# 6. Testy
.pytest_cache/
.tox/
coverage.xml
htmlcov/

# Srodowisko wirtualne
venv/
env/
.env

# Pliki tymczasowe Pythona
__pycache__/
*.py[cod]
*$py.class

# Bazy danych (ABSOLUTNIE NIE WYPYSZAĆ)
*.db
profiles/*.db
vault.db

# Pliki systemowe
.DS_Store
Thumbs.db